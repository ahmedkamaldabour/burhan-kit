{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.burhan/hooks/node/main.mjs",
              "claude",
              "hook",
              "session-gates"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.burhan/hooks/node/main.mjs",
              "claude",
              "hook",
              "prompt-router"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.burhan/hooks/node/main.mjs",
              "claude",
              "hook",
              "pre-commit-check"
            ],
            "timeout": 70
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.burhan/hooks/node/main.mjs",
              "claude",
              "hook",
              "post-edit-reminder"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.burhan/hooks/node/main.mjs",
              "claude",
              "hook",
              "turn-audit"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
